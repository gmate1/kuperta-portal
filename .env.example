# Másold .env néven és töltsd ki. A .env SOHA ne kerüljön gitbe!
#
# Kulcsok generálása:
#   openssl rand -hex 32   → JWT_SECRET és DATA_ENCRYPTION_KEY (külön-külön!)
#   openssl rand -base64 24 → POSTGRES_PASSWORD

POSTGRES_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Első indításhoz (docker compose exec api node scripts/seed.js)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Éles domain (CORS) – pl. https://portal.sajatdomain.hu
PUBLIC_URL=http://localhost:8080
# Lokális, HTTPS nélküli teszthez false, élesben true
COOKIE_SECURE=false
WEB_PORT=8080
