# Másold .env néven és töltsd ki. A .env SOHA ne kerüljön gitbe!
#
# Kulcsok generálása (Git Bash vagy WSL alatt):
#   openssl rand -hex 32    → JWT_SECRET és DATA_ENCRYPTION_KEY (külön-külön!)
#   openssl rand -base64 24 → POSTGRES_PASSWORD
# PowerShellben ugyanez: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })

POSTGRES_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Az első admin felhasználó (min. 12 karakter, kis- és nagybetű, szám)
SEED_ADMIN_EMAIL=admin@kuperta.hu
SEED_ADMIN_PASSWORD=

PORTAL_URL=https://portal.kuperta.hu

# A weboldal Kapcsolat oldalán megjelenő elérhetőségek.
# Üresen hagyva az oldal azt írja, hogy az email cím hamarosan elérhető.
# Módosítás után: docker compose up -d api
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=

# A Cloudflare Zero Trust felületén létrehozott tunnel tokenje (lásd TUNNEL.md)
TUNNEL_TOKEN=
